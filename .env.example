# 复制为 .env 后按需修改
#
# 重要：MySQL 密码若含以下字符，必须做百分号编码，否则连接串会被解析错误
#   /  -> %2F      @  -> %40      :  -> %3A      #  -> %23
# 例如密码 mySecret/Path1 应写成 mySecret%2FPath1
DATABASE_URL="mysql://user:password@127.0.0.1:3306/blog"

# ===== 会话 =====
SESSION_COOKIE_NAME="blog_session"
# 会话有效期（天）
SESSION_TTL_DAYS="14"
# 生产环境（HTTPS）必须为 true，否则 Cookie 会随明文请求发送
COOKIE_SECURE="false"

# ===== 站点 =====
NEXT_PUBLIC_SITE_NAME="Muzzle's Blog"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ===== 缓存 / 限流（当前版本未使用，保留以备扩展）=====
# REDIS_URL="redis://:password@127.0.0.1:6379/0"
