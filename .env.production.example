# ============================================================================
# 生产环境变量模板 —— 复制为 .env.production 并填写真实值
#
# 这个文件**不要提交**（.gitignore 已覆盖 .env*，仅放行 .env.example）
# ============================================================================

# ---- MySQL（容器内部）----
# 用 openssl rand -base64 24 生成，别用示例值
MYSQL_ROOT_PASSWORD="CHANGE_ME_root_password"
MYSQL_DATABASE="muzzle_blog"
MYSQL_USER="blog"
MYSQL_PASSWORD="CHANGE_ME_app_password"

# ---- 应用 ----
APP_PORT="3000"
APP_IMAGE="blog:latest"

NEXT_PUBLIC_SITE_NAME="Muzzle's Blog"
# 对外访问地址，影响站点地图与 OG 元数据
NEXT_PUBLIC_SITE_URL="http://123.249.120.41:3000"

SESSION_COOKIE_NAME="blog_session"
SESSION_TTL_DAYS="14"
SESSION_IDLE_DAYS="7"

# 有 TLS 终止（https）时设为 true —— 这也是生产推荐做法。
# 若直接以 http 暴露，设为 false，但要清楚会话 Cookie 会以明文传输。
COOKIE_SECURE="false"

# ---- 初始管理员（仅在执行种子脚本时使用）----
# 不设置则种子脚本会随机生成并在输出里打印一次
SEED_ADMIN_PASSWORD=""
SEED_READER_PASSWORD=""
