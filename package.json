{
  "name": "muzzle-blog",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:init": "tsx scripts/init-db.ts",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "test:api": "bash scripts/e2e.sh",
    "test:design": "tsx scripts/design-audit.ts",
    "test:case": "tsx scripts/check-case.ts",
    "test": "tsx scripts/check-case.ts && bash scripts/e2e.sh && tsx scripts/design-audit.ts",
    "shots": "tsx scripts/screenshot.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.19.1",
    "dompurify": "^3.1.6",
    "highlight.js": "^11.10.0",
    "jsdom": "^25.0.0",
    "marked": "^14.1.2",
    "marked-highlight": "^2.1.4",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.35",
    "mysql2": "^3.24.4",
    "playwright-core": "^1.63.0",
    "postcss": "^8.4.45",
    "prisma": "5.19.1",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  },
  "packageManager": "pnpm@9.9.0"
}
